APP_NAME=AgentOS API
APP_VERSION=0.1.0
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO
LOG_FORMAT=plain

# Development token endpoint is opt-in and must remain false in production.
DEV_TOKEN_ENABLED=false

# Customer-remediation pilot connector. Leave disabled until a design partner
# approves a Stripe test-mode rehearsal; never place a secret in frontend env.
STRIPE_REFUND_CONNECTOR_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_API_BASE=https://api.stripe.com

# Zendesk ticket metadata is read-only and minimised. Enable only for an
# approved test-mode design-partner rehearsal using a server-side OAuth token.
ZENDESK_CONTEXT_CONNECTOR_ENABLED=false
ZENDESK_SUBDOMAIN=
ZENDESK_OAUTH_ACCESS_TOKEN=

# Provide these only when testing an authenticated configuration. Never commit
# actual identity-provider, database, or webhook credentials.
MCP_AUTH_ISSUER=
MCP_AUTH_AUDIENCE=
MCP_AUTH_JWKS_URL=
MCP_AUTH_PUBLIC_KEY=
MCP_AUTH_SECRET_KEY=
WEBHOOK_SECRET=
